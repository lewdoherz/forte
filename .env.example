# --- Database ---
# Local development uses PGlite (PostgreSQL compiled to WASM) — no server and
# no connection string needed. `bun run db:migrate` applies schema/migrations
# to the .pglite/ data directory.
#
# When moving to a hosted PostgreSQL, set DATABASE_URL; lib/db.ts switches from
# the PGlite dialect to the pg dialect automatically.
# DATABASE_URL="postgresql://user:password@localhost:5432/forte"

# --- Authentication (Better Auth) ---
# Required in production; a dev fallback is used when unset locally.
# BETTER_AUTH_SECRET="a-long-random-secret"
# BETTER_AUTH_URL="http://localhost:3000"
