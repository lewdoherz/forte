# Local development uses PGlite (PostgreSQL compiled to WASM) — no server and
# no connection string needed. `bun run db:migrate` applies schema/migrations
# to the .pglite/ data directory.

# When moving to a hosted PostgreSQL, set DATABASE_URL and swap the PGlite client
# for a `pg` client.
# DATABASE_URL="postgresql://user:password@localhost:5432/forte"
